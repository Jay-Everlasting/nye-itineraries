# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Dashboard: Project Settings -> API Keys

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Used only for Supabase Auth calls (sending/verifying the editor login code).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# SECRET. Bypasses Row Level Security. Since the database is now locked down
# (see 0002_lockdown.sql), the SERVER needs this to read anything at all — so
# unlike before, it DOES belong in Vercel, as a server-only variable.
# Never prefix it with NEXT_PUBLIC_ and never paste it into a chat.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Signs the read/edit session cookies. Any random 32+ byte hex string.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Rotating this immediately signs everyone out.
SESSION_SECRET=

# Comma-separated emails allowed to edit. Seeds the `editors` table on first
# `npm run seed`; after that manage with `npm run editors`.
EDITOR_EMAILS=you@example.com

# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# Dashboard: Project Settings -> API Keys

# Public. Safe in the browser and safe to share. Respects Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxx

# SECRET. Bypasses Row Level Security completely.
# Used ONLY by scripts/seed.mjs on your own machine.
# Never prefix this with NEXT_PUBLIC_, never commit it, never paste it into a chat,
# and never add it to Vercel — the deployed app does not need it.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxx

# Comma-separated emails allowed to edit (picks, pins, admin page).
# Seeded into the `editors` table, which RLS checks via is_editor().
EDITOR_EMAILS=we.need.help.for.uni.work@gmail.com
